# Copy to .env and fill in values. Never commit .env.

# Required
ANTHROPIC_API_KEY=

# Optional: model used by all four agents
# CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Cost protection for POST /api/research (each run makes many API calls)
# Set an access code to require it in the UI (recommended for any public demo)
# AIC_ACCESS_KEY=
# Runs allowed per IP address per window (default: 5 per hour)
# AIC_RATE_LIMIT_RUNS=5
# AIC_RATE_LIMIT_WINDOW_SECONDS=3600
# Research runs allowed at the same time (default: 1)
# AIC_MAX_CONCURRENT_RUNS=1
# Tool-call rounds per agent (default: 12)
# AIC_AGENT_MAX_ITER=12

# FastAPI CORS (comma-separated origins). Default: http://localhost:3000
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-app.example.com

# Next.js (optional; defaults to http://localhost:8000 in the API client)
# NEXT_PUBLIC_API_URL=http://localhost:8000

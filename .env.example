# Copy to .env and fill in values. Never commit .env.

ANTHROPIC_API_KEY=
# Optional
# TAVILY_API_KEY=
# OPENAI_API_KEY=
OPENAI_MODEL=

# FastAPI CORS (comma-separated origins). Default: http://localhost:3000
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-app.example.com

# Next.js (optional; defaults to http://localhost:8000 in api client)
# NEXT_PUBLIC_API_URL=http://localhost:8000
